{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "Jwt": {
    "Issuer": "hdash-api",
    "Audience": "hdash-frontend",
    "ExpirationHours": 24
  },
  "Email": {
    "Provider": "file",
    "Outbox": "outbox",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": "",
      "From": "",
      "FromName": "The Nest"
    }
  },
  "Digest": {
    "Enabled": false,
    "Hour": 6,
    "CheckIntervalMinutes": 15,
    "SkipEmpty": true
  }
}

# Copy to .env and fill in. Only JWT_KEY is required.

# REQUIRED — JWT signing secret, 32+ chars. Generate one:
#   openssl rand -hex 32
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# Where the browser reaches the two services. For a single machine, the defaults
# work. For a remote host, set these to that host's URLs (and rebuild the frontend,
# since NEXT_PUBLIC_API_URL is baked at build time).
# NEXT_PUBLIC_API_URL=http://your-host:5063
# FRONTEND_ORIGIN=http://your-host:3000

# --- Daily email digest (optional) ---
# DIGEST_ENABLED=true
# DIGEST_SKIN=departures        # departures | baseline
# EMAIL_PROVIDER=smtp           # file (dev outbox) | smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com

# --- Backups (on by default, written to the data volume) ---
# BACKUP_ENABLED=true

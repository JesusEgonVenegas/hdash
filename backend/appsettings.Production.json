{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/data/app.db"
  },
  "Jwt": {
    "Issuer": "hdash-api",
    "Audience": "hdash-frontend",
    "ExpirationHours": 24
  },
  "Cors": {
    "AllowedOrigins": "https://your-frontend-domain.com"
  }
}

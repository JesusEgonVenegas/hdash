# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Build results
backend/bin/
backend/obj/
backend.Tests/bin/
backend.Tests/obj/

# User-specific files
backend/*.user
backend/*.rsuser

# Dotnet secrets — ignore environment-specific overrides but keep Production template
backend/appsettings.Development.json
backend/appsettings.Local.json

# SQLite database — should not be committed to version control
backend/app.db
backend/app.db-shm
backend/app.db-wal

# Generated digest emails (dev file sender)
backend/outbox/
backend/bin/**/outbox/

# Database backups
backend/backups/
backend/bin/**/backups/

*.tmp
*.temp
*.bak
*.old

# Coverage
coverage/
lcov.info

# Nix/Dev tools (optional)
.cache/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local
.env.*.local

# Editor configs
.vscode/
.idea/
*.swp

# but keep the template
!.env.example
